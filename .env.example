# Variable names only, no real secrets. Inside DDEV the non-secret values are set in
# .ddev/config.voice-agent.yaml, and secrets go in .ddev/.env.web (ignored by git).
DATABASE_URL=postgresql://db:db@db:5432/db

# Language models (see packages/pipeline/src/registry.ts)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
