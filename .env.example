# Variable names only, no real secrets. Inside DDEV the non-secret values are set in
# .ddev/config.voice-agent.yaml, and secrets go in .ddev/.env.web (ignored by git).
DATABASE_URL=postgresql://db:db@db:5432/db

# Language models (see packages/pipeline/src/registry.ts)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING_EFFORT=none
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1-nano,gpt-4o-mini
OPENAI_API_KEY=

# Tools (packages/tools). Only for local development: allow tools to reach private addresses.
TOOLS_ALLOW_PRIVATE_HOSTS=false

# Knowledge base embedding models (comma-separated; the first is used in calls).
EMBEDDING_MODELS=ollama/nomic-embed-text,openai/text-embedding-3-small

# Speech for voice calls: "openai" (needs OPENAI_API_KEY) or "mock".
VOICE_STT=openai
VOICE_TTS=openai

# Phone calls: the voice gateway and the web app share this secret. Twilio credentials are only
# needed to transfer live calls to a person.
GATEWAY_SECRET=
PHONE_MODEL=openai/gpt-4.1-nano
WEB_URL=http://localhost:3000
PUBLIC_HOST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Auth: encrypts each business's own API keys (32+ random characters in production), and the
# demo owner's password (demo@example.com) for the seed.
APP_SECRET=
DEMO_PASSWORD=
