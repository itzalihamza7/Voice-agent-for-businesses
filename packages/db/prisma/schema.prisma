// PostgreSQL schema. Tables use snake_case names (@@map / @map); Prisma models use PascalCase.
//
// After changing models: run `ddev npm run db:migrate -- --name <what-changed>`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A company using the platform. Only one ("demo-business") until auth arrives (roadmap phase 15).
model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  agents Agent[]
  calls  Call[]

  @@map("businesses")
}

// A voice agent. Its design lives in AgentConfigVersion rows, never in this table.
model Agent {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  // Copy of the latest version's name, so agent lists don't need to read JSON.
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions AgentConfigVersion[]
  calls    Call[]

  @@index([businessId])
  @@map("agents")
}

// One saved version of an agent's config. Rows are never updated: saving creates version + 1.
// `config` holds the full AgentConfig JSON, validated by Zod (@voice-agent/shared) on write and read.
model AgentConfigVersion {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  version   Int
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@map("agent_config_versions")
}

enum Sentiment {
  positive
  neutral
  negative
}

enum Speaker {
  caller
  agent
}

// One phone (or simulated) call. agentVersion records which config handled it, for A/B tests.
model Call {
  id           String     @id @default(uuid())
  businessId   String     @map("business_id")
  agentId      String     @map("agent_id")
  agentVersion Int        @map("agent_version")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  sentiment    Sentiment?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent    Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  turns    TranscriptTurn[]

  @@index([businessId, startedAt])
  @@index([agentId])
  @@map("calls")
}

// One spoken turn in a call.
model TranscriptTurn {
  id      String  @id @default(uuid())
  callId  String  @map("call_id")
  speaker Speaker
  text    String
  // Milliseconds since the call started.
  atMs    Int     @map("at_ms")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, atMs])
  @@map("transcript_turns")
}
