// PostgreSQL schema. Tables use snake_case names (@@map / @map); Prisma models use PascalCase.
//
// After changing models: run `ddev npm run db:migrate -- --name <what-changed>`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A company using the platform. Only one ("demo-business") until auth arrives (roadmap phase 15).
model Business {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  // Set by a platform admin: the business's users can't sign in and its numbers don't answer.
  suspendedAt DateTime? @map("suspended_at")

  agents             Agent[]
  calls              Call[]
  knowledgeDocuments KnowledgeDocument[]
  callerMemories     CallerMemory[]
  users              User[]
  secrets            BusinessSecret[]
  connections        Connection[]

  @@map("businesses")
}

// A voice agent. Its design lives in AgentConfigVersion rows, never in this table.
model Agent {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  // Copy of the latest version's name, so agent lists don't need to read JSON.
  name        String
  // The version callers get. null = none published yet (the latest version is used).
  liveVersion Int?     @map("live_version")
  // The phone number callers dial to reach this agent (E.164, e.g. +441632960000).
  phoneNumber String?  @unique @map("phone_number")
  // A/B test: this share (0-100) of new calls gets abVersion instead of the live version.
  abVersion   Int?     @map("ab_version")
  abPercent   Int?     @map("ab_percent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions  AgentConfigVersion[]
  calls     Call[]
  evalCases EvalCase[]
  evalRuns  EvalRun[]
  releases  Release[]

  @@index([businessId])
  @@map("agents")
}

// One saved version of an agent's config. Rows are never updated: saving creates version + 1.
// `config` holds the full AgentConfig JSON, validated by Zod (@voice-agent/shared) on write and read.
model AgentConfigVersion {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  version   Int
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@map("agent_config_versions")
}

enum Sentiment {
  positive
  neutral
  negative
}

enum Speaker {
  caller
  agent
}

// One phone (or simulated) call. agentVersion records which config handled it, for A/B tests.
model Call {
  id           String     @id @default(uuid())
  businessId   String     @map("business_id")
  agentId      String     @map("agent_id")
  agentVersion Int        @map("agent_version")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  sentiment    Sentiment?
  // "test" (builder test chat) or "phone" (voice gateway).
  source       String     @default("test")
  // The LangGraph thread the call ran in.
  threadId     String?    @unique @map("thread_id")
  callerPhone  String?    @map("caller_phone")
  // Every event of the call with its time (ms since the start): what the dashboard traces.
  trace        Json?
  // Language model cost, summed from the trace.
  costUsd      Float?     @map("cost_usd")
  // Post-call analysis by a language model.
  summary      String?
  intent       String?
  // "resolved", "transferred", "unresolved" or "failed".
  outcome      String?
  // Problems found in the trace (guardrails, model errors, a stuck flow).
  flags        Json?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent    Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  turns    TranscriptTurn[]

  @@index([businessId, startedAt])
  @@index([agentId])
  @@map("calls")
}

// One spoken turn in a call.
model TranscriptTurn {
  id      String  @id @default(uuid())
  callId  String  @map("call_id")
  speaker Speaker
  text    String
  // Milliseconds since the call started.
  atMs    Int     @map("at_ms")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, atMs])
  @@map("transcript_turns")
}

// ----- Knowledge base (RAG, roadmap phase 6) -------------------------------------------------
// Documents belong to a business and are shared by all its agents. Each document is split into
// chunks; each chunk is embedded once per embedding model, so models can be compared.

model KnowledgeDocument {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  title      String
  // "text" (pasted text or FAQ), "url" (a web page) or "pdf".
  sourceType String   @map("source_type")
  sourceUrl  String?  @map("source_url")
  // How it was split: "fixed", "headings" or "semantic".
  chunking   String
  // The full extracted text, so the document can be chunked again later.
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@index([businessId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String  @id @default(uuid())
  documentId String  @map("document_id")
  // Copied from the document, so every search can filter by business without a join.
  businessId String  @map("business_id")
  position   Int
  heading    String?
  // Keyword search computes the full-text vector (to_tsvector) when searching: fine for a
  // business's knowledge base. At large scale, add a stored tsvector column with a GIN index.
  content    String

  document   KnowledgeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings KnowledgeEmbedding[]

  @@index([businessId])
  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
  chunkId   String                @map("chunk_id")
  // e.g. "ollama/nomic-embed-text": vectors from different models can't be compared.
  model     String
  // pgvector, without a fixed size, so models with different sizes share one table.
  // (An ANN index would need a fixed size; exact search is fine for a business's FAQ.)
  embedding Unsupported("vector")

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, model])
  @@map("knowledge_embeddings")
}

// ----- Caller memory (roadmap phase 7) --------------------------------------------------------
// What an agent remembers about a caller between calls, by phone number (caller ID): a few
// short facts written by the AI at the end of each call and checked by code.

model CallerMemory {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  // Normalized: digits, with a leading "+" if it had one.
  phoneNumber String   @map("phone_number")
  // A JSON array of short sentences, e.g. ["Name is Ali.", "Prefers Priya."].
  facts       Json
  // How many calls updated this memory.
  callCount   Int      @default(0) @map("call_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber])
  @@map("caller_memories")
}

// ----- Evals (roadmap phase 8) ----------------------------------------------------------------
// Test cases per agent, and runs of them against a version. A version can only go live after a
// run, and not if its score dropped (the regression gate).

model EvalCase {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  name       String
  // { kind: "script" | "simulated", ... }, validated by Zod (@voice-agent/shared, evals.ts).
  definition Json
  // Extra rubric lines for the judge.
  criteria   Json
  createdAt  DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("eval_cases")
}

model EvalRun {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  agentVersion Int      @map("agent_version")
  // Which models ran the agent, played the callers and judged.
  models       Json
  // "running" until every case has a result, then "done".
  status       String
  // 0–100, set when done.
  score        Float?
  // The cases to run, in order, and their results so far.
  caseIds      Json     @map("case_ids")
  results      Json
  createdAt    DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("eval_runs")
}

// ----- Releases (roadmap phase 14) ------------------------------------------------------------
// Every change to what callers get: a version going live, a rollback, an A/B split starting or
// stopping. The history is what a rollback goes back to.

model Release {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  version   Int?
  // "live", "rollback", "split" or "split-stopped".
  kind      String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("releases")
}

// ----- Users and access (roadmap phase 15) ----------------------------------------------------

enum Role {
  // Everything, including users and API keys.
  owner
  // Builds agents, knowledge and evals.
  editor
  // Looks and runs test calls; changes nothing.
  viewer
}

model User {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  email           String   @unique
  name            String
  // scrypt: "salt:hash", both hex.
  passwordHash    String   @map("password_hash")
  role            Role     @default(editor)
  // Platform admins run the platform itself: every business, usage and suspensions.
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([businessId])
  @@map("users")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A business's own vendor keys (e.g. OPENAI_API_KEY), encrypted with AES-256-GCM (APP_SECRET).
model BusinessSecret {
  businessId String   @map("business_id")
  name       String
  // base64 of iv (12 bytes) + auth tag (16 bytes) + ciphertext.
  value      String
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, name])
  @@map("business_secrets")
}

// ----- Connections to the business's own apps --------------------------------------------------
// A business's app API (e.g. its shop): base URL, how to authenticate, and the actions agents may
// call as tools. The secret (API key or token) is encrypted like the business's other secrets.

model Connection {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  // Prefix for the tools' names, e.g. "chafer" → chafer_check_stock.
  slug       String
  baseUrl    String   @map("base_url")
  // "none", "bearer" (Authorization: Bearer <secret>) or "header" (<authHeader>: <secret>).
  authType   String   @default("none") @map("auth_type")
  authHeader String?  @map("auth_header")
  // base64 of iv + tag + ciphertext (AES-256-GCM with APP_SECRET); null when there is none.
  secret     String?
  // [{ name, description, method, path, parameters: [...] }], validated by Zod.
  actions    Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@map("connections")
}
