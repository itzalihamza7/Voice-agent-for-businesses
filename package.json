{
  "name": "voice-agent-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @voice-agent/web",
    "build": "npm run typecheck && npm run build -w @voice-agent/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @voice-agent/db",
    "db:migrate": "npm run db:migrate -w @voice-agent/db",
    "db:seed": "npm run db:seed -w @voice-agent/db",
    "db:setup": "npm run db:setup -w @voice-agent/db",
    "kb:seed": "npm run kb:seed -w @voice-agent/rag",
    "test:e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
